# ─────────────────────────────────────────────────────────────
# Ossilith Deployment Environment Template (.env.example)
# Copy to .env and configure or run ./setup.sh
# ─────────────────────────────────────────────────────────────

# ── Application Security ─────────────────────────────────────
# Replace with a 256-bit cryptographically secure random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-in-production-use-setup-sh

# ── Database (Async SQLite inside Docker volume) ─────────────
DATABASE_URL=sqlite+aiosqlite:////data/ossilith.db
DATA_DIR=/data/cases

# ── Redis Task Broker & Cache ────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── nnInteractive Local GPU Inference ────────────────────────
NNINTERACTIVE_MODE=remote
NNINTERACTIVE_URL=http://nninteractive:1527
NNINTERACTIVE_API_KEY=
NNINTERACTIVE_PORT=1527
NN_MAX_SESSIONS=4
CUDA_VISIBLE_DEVICES=0

# ── Exposed Host Ports ───────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ── Background Worker Concurrency ────────────────────────────
CELERY_CONCURRENCY=2
